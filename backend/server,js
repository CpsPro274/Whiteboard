const express = require('express');
const http = require('http');
const { Server } = require('socket.io');
const mongoose = require('mongoose');
const cors = require('cors');
require('dotenv').config();

const app = express();
app.use(cors());
const server = http.createServer(app);
const io = new Server(server, {
  cors: { origin: "http://localhost:5173" }
});
mongoose.connect(process.env.MONGO_URI)
  .then(() => console.log("✅ DB Connected"))
  .catch(err => console.log("❌ DB Error:", err));
const Click = mongoose.model('login', new mongoose.Schema({ x: Number, y: Number }), 'login');
io.on('connection', (socket) => {
  console.log('User connected:', socket.id);

  socket.on('test-click', async (data) => {
    const savedClick = await Click.create(data);
    console.log("Saved to DB:", savedClick);
    socket.broadcast.emit('sync-click', savedClick);
  });
});

const PORT = process.env.PORT || 5000;
server.listen(PORT, () => console.log(`Server on http://localhost:${PORT}`));